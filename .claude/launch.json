{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "mvn",
      "runtimeArgs": [
        "-q",
        "-f",
        "backend/pom.xml",
        "-Dnet.bytebuddy.experimental=true",
        "spring-boot:run",
        "-Dspring-boot.run.arguments=--sync.enabled=false"
      ],
      "port": 8080
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev",
        "--",
        "--host",
        "--port",
        "5183",
        "--strictPort"
      ],
      "port": 5183
    }
  ]
}